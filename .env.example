# =============================================
# 台灣生活小助手 MCP Server - 環境變數範本
# =============================================
# 複製此檔案為 .env，填入你自己的 API 金鑰
#   cp .env.example .env

# ① 中央氣象局 Open Data API（天氣預報 / 觀測 / 一週鄉鎮預報）
# 申請網址：https://opendata.cwa.gov.tw/userLogin
CWA_API_KEY=your-cwa-authorization-code

# ② 交通部 TDX API（公車 / 台鐵 / 高鐵）
# 申請網址：https://tdx.transportdata.tw/register
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret

# ③ Google Calendar OAuth2（查詢 / 建立 / 修改 / 刪除事件、找空檔）
# 申請步驟：
#   1. 前往 https://console.cloud.google.com/
#   2. 建立新專案或選擇現有專案
#   3. 啟用 Google Calendar API
#   4. 建立「OAuth 2.0 用戶端 ID」（選擇「桌面應用程式」類型）
#   5. 下載 JSON 憑證，儲存為 google_credentials.json
# ⚠️ 本版本已將 OAuth scope 由唯讀改為可寫事件（calendar.events）。
#    若你是從舊版升級，請先刪除舊的 google_token.json 再重新授權，否則寫入會 403。
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_TOKEN_FILE=google_token.json

# 註：以下功能免金鑰，無需設定環境變數
#   - 國定假日 / 補班日查詢（TaiwanCalendar 開源資料，jsDelivr CDN）
#   - 台灣銀行牌告匯率查詢（rate.bot.com.tw）
